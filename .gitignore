# Ignore dependencies from npm and Composer:
/node_modules
/vendor

# Ignore generated JavaScript files (esbuild output; does not cover
# vendored libraries under theme/assets/):
/theme/js/*.min.js

# Ignore generated CSS files:
style.css
style-editor.css
style-editor-extra.css
tailwind-intellisense.css

# Ignore the generated zip file(s), including versioned release zips:
/ednx.zip
/ednx-v*.zip

# Ignore .DS_Store files from macOS:
.DS_Store
